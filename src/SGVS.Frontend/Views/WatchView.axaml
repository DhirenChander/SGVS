<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SGVS.Frontend.ViewModels"
             xmlns:m="using:SGVS.Frontend.Models"
             xmlns:vlc="clr-namespace:LibVLCSharp.Avalonia;assembly=LibVLCSharp.Avalonia"
             xmlns:controls="using:SGVS.Frontend.Views.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
             x:Class="SGVS.Frontend.Views.WatchView"
             x:DataType="vm:WatchViewModel">

    <!-- everything below binds to this. at runtime the ViewLocator sets it from MainViewModel.CurrentView -->
    <Design.DataContext>
        <vm:WatchViewModel />
    </Design.DataContext>

    <!-- no title-bar margin hack here anymore - MainWindow draws its own 36px bar on top
         of whatever view is current, so every element below just leaves 36px at the top
         itself (see the Stream border and member rail margins) -->
    <Panel Background="{DynamicResource BgBrush}">

        <!-- the stream. StreamHost normally holds the overlay (gear/bar/fullscreen) as a
             plain child so it sits over the placeholder image; once real video starts it
             gets moved into VideoSurface.Content instead, because a NativeControlHost
             (what VideoView really is under the hood) paints outside Avalonia's own
             compositing - anything just stacked on top of it in the visual tree gets
             hidden behind it. VideoView exposes exactly this "floating overlay content"
             as its Content property, so the move is all WatchView.axaml.cs does. -->
        <Border x:Name="StreamBorder" Margin="8,36,72,9" CornerRadius="8" ClipToBounds="True"
                BoxShadow="0 12 34 0 #80000000">
            <Panel x:Name="StreamHost" Background="Black">
                <Image x:Name="StreamImage" Source="{Binding StreamFrame}" Stretch="UniformToFill" />
                <!-- hidden until there is a video, see WatchView.axaml.cs -->
                <vlc:VideoView x:Name="VideoSurface" IsVisible="False" />
                <!-- FlyoutOpened/FlyoutClosed are wired in code-behind (needs a closure
                     over _suppressAutoHide), not here -->
                <controls:StreamOverlay x:Name="Overlay" FullscreenRequested="OnFullscreenRequested" />
            </Panel>
        </Border>

        <!-- member rail: one ring per person, initials only. no camera tiles and no
             header text in this design - just a colored ring with a gradient "live" ring
             drawn around whoever is currently streaming -->
        <ItemsControl x:Name="MembersRail" Width="72" HorizontalAlignment="Right" VerticalAlignment="Center"
                      Margin="0,36,0,74" ItemsSource="{Binding Participants}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Spacing="12" HorizontalAlignment="Center" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="m:Participant">
                    <Panel Width="44" Height="44" ToolTip.Tip="{Binding Name}">
                        <Ellipse Width="50" Height="50" StrokeThickness="1.5" Stroke="{StaticResource LiveRingBrush}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsStreamer}" />
                        <Ellipse StrokeThickness="1.5" Stroke="{Binding AvatarBrush}" />
                        <!-- VerticalAlignment="Center" centers the font's line box, not the
                             glyph - the line box has more reserved space above the cap
                             height than below the baseline, so the letter renders a couple
                             pixels high. measured it dead center horizontally and ~1.6px
                             high at this font size, hence the small top margin -->
                        <TextBlock Text="{Binding Initials}" FontSize="17" FontWeight="Medium" Margin="0,3,0,0"
                                   Foreground="{Binding AvatarBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextAlignment="Center" />
                    </Panel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- join-code rail, bottom-right. lives outside the stream border on purpose -
             it's never supposed to be hidden by the auto-hide timer or sit behind the
             native video surface, so it isn't part of StreamOverlay at all -->
        <Border x:Name="CodeRail" Width="72" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,14">
            <StackPanel>
                <!-- collapsed: just the key icon -->
                <Button Classes="iconbtn" Width="72" Height="40" IsVisible="{Binding !IsCodeRevealed}"
                        Command="{Binding ToggleCodeCommand}" ToolTip.Tip="Show join code" AutomationProperties.Name="Show join code">
                    <Panel Width="20" Height="20">
                        <Path Data="{StaticResource KeyIcon}" Classes="icon" Stroke="{DynamicResource MutedTextBrush}" />
                    </Panel>
                </Button>

                <!-- revealed: the code split over two lines (matches the mockup). clicking
                     the code itself copies it (with a brief "Copied!" swap-in for
                     feedback); the button below hides the code again, back to the key icon -->
                <StackPanel IsVisible="{Binding IsCodeRevealed}" Spacing="6" HorizontalAlignment="Center" Margin="0,6">
                    <!-- Background="Transparent" is load-bearing: a Panel with no background
                         at all only hit-tests the actual glyph ink, not the gaps between the
                         two code lines, so most clicks in the "clickable area" would silently
                         miss - same thing StreamHost needs Background="Black" for -->
                    <Panel Background="Transparent" Cursor="Hand" PointerPressed="OnCodeTextPressed" ToolTip.Tip="Click to copy">
                        <StackPanel Spacing="2" IsVisible="{Binding !IsCodeCopied}">
                            <TextBlock Text="{Binding JoinCodeFirstHalf}" FontFamily="JetBrains Mono,Consolas,monospace"
                                       FontSize="14" LetterSpacing="0.84" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding JoinCodeSecondHalf}" FontFamily="JetBrains Mono,Consolas,monospace"
                                       FontSize="14" LetterSpacing="0.84" HorizontalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="Copied!" FontSize="13" FontWeight="Medium" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource AccentBrush}" IsVisible="{Binding IsCodeCopied}" />
                    </Panel>
                    <Button Classes="iconbtn" Click="OnHideCodeClick" ToolTip.Tip="Hide join code" AutomationProperties.Name="Hide join code">
                        <Panel Width="18" Height="18">
                            <!-- CaretUpIcon flipped - "collapse" is the same shape as "open", upside down -->
                            <Path Data="{StaticResource CaretUpIcon}" Classes="icon" Stroke="{DynamicResource MutedTextBrush}"
                                  RenderTransform="scaleY(-1)" />
                        </Panel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Panel>
</UserControl>
