<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- the window's title bar, from Figma "Window / Title bar": no title text, just minimize / maximize / close
         at 44x36 with the Figma icons. replaces Fluent's version, which printed the app name top-left and had a
         fullscreen button. MainWindow uses it through WindowDecorationsTheme.

         nothing here handles clicks: each part has an ElementRole, and Avalonia turns those into the native
         title bar behavior (minimize, maximize + snap layouts, close, drag, double-click to maximize).
         pages that paint their own background over the top 36px need a TitleBar strip too (see MeetingView) -->
    <ControlTheme x:Key="SgvsWindowDecorations" TargetType="WindowDrawnDecorations">
        <Setter Property="DefaultTitleBarHeight" Value="36" />
        <!-- same as Fluent. only used where the OS doesn't draw the frame itself (not Windows 11) -->
        <Setter Property="DefaultFrameThickness" Value="1" />
        <Setter Property="DefaultShadowThickness" Value="8" />
        <Setter Property="Template">
            <WindowDrawnDecorationsTemplate>
                <WindowDrawnDecorationsContent>
                    <!-- below the page: the frame, and the strip you drag the window by -->
                    <WindowDrawnDecorationsContent.Underlay>
                        <Panel>
                            <Border BorderBrush="{DynamicResource SgvsSurfaceRaisedBrush}"
                                    BorderThickness="{TemplateBinding FrameThickness}"
                                    IsVisible="{TemplateBinding HasBorder}" />
                            <Panel Background="Transparent" VerticalAlignment="Top"
                                   Height="{TemplateBinding TitleBarHeight}"
                                   IsVisible="{TemplateBinding HasTitleBar}"
                                   WindowDecorationProperties.ElementRole="TitleBar" />
                        </Panel>
                    </WindowDrawnDecorationsContent.Underlay>

                    <!-- above the page: the three window buttons, top-right -->
                    <WindowDrawnDecorationsContent.Overlay>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    IsVisible="{TemplateBinding HasTitleBar}">
                            <Button Classes="flat caption" WindowDecorationProperties.ElementRole="MinimizeButton"
                                    AutomationProperties.Name="Minimize">
                                <Panel Width="14" Height="14">
                                    <Path Classes="lineicon" Data="{StaticResource SgvsMinimizeIcon}" />
                                </Panel>
                            </Button>
                            <Button Classes="flat caption" WindowDecorationProperties.ElementRole="MaximizeButton"
                                    AutomationProperties.Name="Maximize">
                                <Panel Width="14" Height="14">
                                    <Path Classes="lineicon" Data="{StaticResource SgvsMaximizeIcon}" />
                                </Panel>
                            </Button>
                            <Button Classes="flat caption" WindowDecorationProperties.ElementRole="CloseButton"
                                    AutomationProperties.Name="Close">
                                <Panel Width="14" Height="14">
                                    <Path Classes="lineicon" Data="{StaticResource SgvsCloseIcon}" />
                                </Panel>
                            </Button>
                        </StackPanel>
                    </WindowDrawnDecorationsContent.Overlay>

                    <!-- slides in at the top in fullscreen. nothing enters fullscreen yet, but keep a way out -->
                    <WindowDrawnDecorationsContent.FullscreenPopover>
                        <Panel Height="36" VerticalAlignment="Top" Background="{DynamicResource SgvsGroundBrush}"
                               WindowDecorationProperties.ElementRole="DecorationsElement">
                            <Button Classes="flat caption" HorizontalAlignment="Right"
                                    WindowDecorationProperties.ElementRole="CloseButton" AutomationProperties.Name="Close">
                                <Panel Width="14" Height="14">
                                    <Path Classes="lineicon" Data="{StaticResource SgvsCloseIcon}" />
                                </Panel>
                            </Button>
                        </Panel>
                    </WindowDrawnDecorationsContent.FullscreenPopover>
                </WindowDrawnDecorationsContent>
            </WindowDrawnDecorationsTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
