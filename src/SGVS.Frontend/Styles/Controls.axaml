<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Avalonia wraps every Flyout's content in its own FlyoutPresenter, which the
         Fluent theme styles with a themed background, padding, corner radius and drop
         shadow of its own - the resolution and settings menus already draw their own
         glass Border to match the control bar, so that default chrome was doubling up
         right behind it (different radius/background peeking out past our rounded
         corners, an extra shadow on top of ours). Stripped down to a bare content host
         so the only chrome visible is the one we actually designed. -->
    <Style Selector="FlyoutPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
    </Style>

    <!-- every icon in the new mockup is a line icon (stroke, round caps/joins), not a
         filled glyph like the old Material ones were, so Path.icon now strokes instead
         of filling. local Stroke="..." on a Path still overrides this per the usual rules,
         that's how Leave/caret/key/copy get their own colors below -->
    <Style Selector="Path.icon">
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Stroke" Value="{DynamicResource TextBrush}" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StrokeJoin" Value="Round" />
    </Style>

    <!-- the diagonal "off" slash drawn over the mic icon when muted -->
    <Style Selector="Line.slash">
        <Setter Property="Stroke" Value="{DynamicResource DangerTextBrush}" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeLineCap" Value="Round" />
    </Style>

    <!-- mic toggle, the one control-bar segment that isn't in the design (figma has no
         viewer mic control on this screen). kept it square like the others instead of
         giving it its own look, so it doesn't stand out as bolted-on -->
    <Style Selector="ToggleButton.micseg">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ToggleButton.micseg /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="ToggleButton.micseg:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource GlassHoverBrush}" />
    </Style>

    <!-- the other control-bar segments: resolution, stop watching, start stream, leave.
         just text/icon over transparent, a faint tint on hover - the bar's own glass
         border already does the heavy lifting so these don't need their own -->
    <Style Selector="Button.barseg">
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.barseg /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.barseg:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource GlassHoverBrush}" />
    </Style>

    <!-- square glass buttons floating directly on the stream: settings gear, fullscreen.
         unlike the bar segments these need their own visible background since there's no
         parent bar supplying one - same recipe as the bar border (ground @ 56% + hairline) -->
    <Style Selector="Button.glass">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.glass /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource GlassBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.glass:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource GlassHoverBrush}" />
    </Style>

    <!-- small invisible button around the volume icon, lights up on hover.
         unchanged from before, still fits the new bar fine -->
    <Style Selector="Button.iconbtn">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.iconbtn /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="16" />
    </Style>
    <Style Selector="Button.iconbtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource GlassHoverBrush}" />
    </Style>
    <Style Selector="Button.iconbtn:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource GlassHoverBrush}" />
    </Style>

    <!-- menu row, one per entry in a Flyout list - resolution picker and the settings
         panel both use this, so they read as the same kind of menu instead of two
         different-looking lists. CornerRadius matches every other pill/segment in the
         app (6, same as barseg/micseg) - resrow was missing it before, which made the
         hover fill look like a flat rectangle floating in an otherwise all-rounded UI -->
    <Style Selector="Button.resrow">
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.resrow /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.resrow:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource GlassHoverBrush}" />
    </Style>
    <!-- the selected resolution gets a standing teal tint, not just a text-color change -
         same accent used by the volume fill and the streamer's live ring, so "this one is
         active" reads the same way everywhere in the app -->
    <Style Selector="Button.resrow.selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#1A53C9C9" />
    </Style>
    <Style Selector="Button.resrow.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#2653C9C9" />
    </Style>

    <!-- settings-menu toggle pill. hand-built rather than a stock ToggleSwitch, since
         this app never uses default Fluent chrome anywhere else - retinting a stock
         control's theme resources here would be the one thing in the UI not built from
         the same Border/Path/Line primitives as everything else. the knob's position
         flips per-row in code (see RebuildSettingsOptions), same reasoning as the
         resolution rows needing code too - toggletrack is the pill, toggleknob the dot -->
    <Style Selector="Border.toggletrack">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="20" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Ellipse.toggleknob">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Fill" Value="{DynamicResource TextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Transitions">
            <Transitions>
                <ThicknessTransition Property="Margin" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>

    <!-- minimize/maximize/close, drawn by MainWindow itself - see the comment there -->
    <Style Selector="Button.titlebar">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.titlebar /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.titlebar:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource GlassHoverBrush}" />
    </Style>

    <!-- thin teal volume slider, a sliver of a track rather than the usual chunky Fluent
         one. these are the theme's own resource keys, same trick as before -->
    <Style Selector="Slider.volume">
        <Style.Resources>
            <SolidColorBrush x:Key="SliderTrackFill" Color="#42F0EEEC" />
            <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#42F0EEEC" />
            <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#42F0EEEC" />
            <SolidColorBrush x:Key="SliderTrackValueFill" Color="#53C9C9" />
            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#53C9C9" />
            <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#53C9C9" />
            <SolidColorBrush x:Key="SliderThumbBackground" Color="#F0EEEC" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#F0EEEC" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#F0EEEC" />
            <x:Double x:Key="SliderTrackThemeHeight">3</x:Double>
            <x:Double x:Key="SliderHorizontalThumbWidth">10</x:Double>
            <x:Double x:Key="SliderHorizontalThumbHeight">10</x:Double>
        </Style.Resources>
    </Style>

    <!-- ===================================================================================
         SGVS (Figma) controls, used by MeetingView. sizes and colors are the Sgvs* tokens
         =================================================================================== -->

    <!-- Figma line icons (Sgvs*Icon). drawn at their real size, no stretching, from the top-left of a
         Panel that is the icon's size. text-muted by default, add a color class for the others
         (a Stroke set on the Path itself got lost inside the gallery's DataTemplate, classes don't) -->
    <Style Selector="Path.lineicon">
        <Setter Property="Stretch" Value="None" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StrokeJoin" Value="Round" />
        <Setter Property="Stroke" Value="{DynamicResource SgvsTextMutedBrush}" />
    </Style>
    <Style Selector="Path.lineicon.text">
        <Setter Property="Stroke" Value="{DynamicResource SgvsTextBrush}" />
    </Style>
    <Style Selector="Path.lineicon.onaccent">
        <Setter Property="Stroke" Value="{DynamicResource SgvsOnAccentBrush}" />
    </Style>
    <Style Selector="Path.lineicon.accent">
        <Setter Property="Stroke" Value="{DynamicResource SgvsAccentBrush}" />
    </Style>
    <Style Selector="Path.lineicon.danger">
        <Setter Property="Stroke" Value="{DynamicResource SgvsDangerTextBrush}" />
    </Style>

    <!-- base for every SGVS button: a flat background plus a hover wash on top.
         Figma has no hover/pressed states, so the wash (SgvsHoverBrush) is the only addition -->
    <Style Selector="Button.flat">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource SgvsTextBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource SgvsRadiusControl}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="{DynamicResource SgvsUiFont}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" />
                    <Border Name="PART_Wash" Background="{DynamicResource SgvsHoverBrush}"
                            CornerRadius="{TemplateBinding CornerRadius}" IsVisible="False" />
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Padding="{TemplateBinding Padding}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.flat:pointerover /template/ Border#PART_Wash">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Button.flat:pressed /template/ Border#PART_Wash">
        <Setter Property="IsVisible" Value="True" />
        <Setter Property="Background" Value="{DynamicResource SgvsPressedBrush}" />
    </Style>
    <!-- fluent colors the presenter on hover/press. our background lives on the Borders above, so keep it clear -->
    <Style Selector="Button.flat /template/ ContentPresenter#PART_ContentPresenter, Button.flat:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.flat:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!-- Figma "Button / Bar": Start stream, Stop stream, Leave -->
    <Style Selector="Button.flat.bar">
        <Setter Property="Background" Value="{DynamicResource SgvsSurfaceRaisedBrush}" />
        <Setter Property="Height" Value="{DynamicResource SgvsSizeControl}" />
        <Setter Property="Padding" Value="16,0" />
    </Style>
    <!-- Figma "Button / Accent": Watch -->
    <Style Selector="Button.flat.accent">
        <Setter Property="Background" Value="{DynamicResource SgvsAccentBrush}" />
        <Setter Property="Height" Value="{DynamicResource SgvsSizeControl}" />
        <Setter Property="Padding" Value="16,0" />
    </Style>
    <!-- 40x40 icon-only buttons: settings gear, code key -->
    <Style Selector="Button.flat.square">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
    </Style>
    <!-- the revealed code: text + copy icon, 40 tall, hugs its content -->
    <Style Selector="Button.flat.code">
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="10,0" />
    </Style>
    <!-- rows in the glass stream menu -->
    <Style Selector="Button.flat.menuitem">
        <Setter Property="Height" Value="{DynamicResource SgvsSizeControl}" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>

    <!-- Figma text styles -->
    <Style Selector="TextBlock.label">          <!-- Button/Label -->
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.tilename">       <!-- Tile/Name -->
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource SgvsTextBrush}" />
    </Style>
</Styles>
