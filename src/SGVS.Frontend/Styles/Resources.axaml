    <!-- ===================================================================================
         Watch screen + control bar extras. same Sgvs* naming as above
         =================================================================================== -->

    <!-- hover tint, bar separators and the "off" toggle pill. none of these are in Figma -->
    <SolidColorBrush x:Key="SgvsGlassHoverBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="SgvsSeparatorBrush" Color="#29F0EEEC" />
    <SolidColorBrush x:Key="SgvsToggleOffBrush" Color="#33F0EEEC" />

    <!-- icons the Watch screen needs that the Figma line-icon set above doesn't have.
         these are drawn with Path.icon (stretched to their box) instead of Path.lineicon.
         Mic is hand-picked from the same Feather family since the design has no viewer mic -->
    <StreamGeometry x:Key="SgvsMicIcon">M12,1C10.8954,1 10,1.89543 10,3V11C10,12.1046 10.8954,13 12,13C13.1046,13 14,12.1046 14,11V3C14,1.89543 13.1046,1 12,1Z M19,10V12C19,15.866 15.866,19 12,19C8.13401,19 5,15.866 5,12V10 M12,19V23 M8,23H16</StreamGeometry>
