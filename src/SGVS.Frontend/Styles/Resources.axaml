    <StreamGeometry x:Key="SgvsFullscreenIcon">M13.3333,3.33333H16.6667V6.66667 M11.6667,8.33333L16.6667,3.33333 M6.66667,16.6667H3.33333V13.3333 M3.33333,16.6667L8.33333,11.6667 M13.3333,16.6667H16.6667V13.3333 M11.6667,11.6667L16.6667,16.6667 M6.66667,3.33333H3.33333V6.66667 M3.33333,3.33333L8.33333,8.33333</StreamGeometry>
    <!-- no minimize icon: a flat line has zero height and breaks Path's Stretch=Uniform,
         so MainWindow draws it as a plain Line (the mute slash does the same) -->
    <StreamGeometry x:Key="SgvsWindowMaximizeIcon">M1.75,2.91667C1.75,2.60725 1.87292,2.3105 2.09171,2.09171C2.3105,1.87292 2.60725,1.75 2.91667,1.75H11.0833C11.3928,1.75 11.6895,1.87292 11.9083,2.09171C12.1271,2.3105 12.25,2.60725 12.25,2.91667V11.0833C12.25,11.3928 12.1271,11.6895 11.9083,11.9083C11.6895,12.1271 11.3928,12.25 11.0833,12.25H2.91667C2.60725,12.25 2.3105,12.1271 2.09171,11.9083C1.87292,11.6895 1.75,11.3928 1.75,11.0833V2.91667Z</StreamGeometry>
    <StreamGeometry x:Key="SgvsWindowCloseIcon">M10.5,3.5L3.5,10.5 M3.5,3.5L10.5,10.5</StreamGeometry>
</ResourceDictionary>
