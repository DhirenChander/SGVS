<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- every color in the app lives in this file, so swapping the palette is a one-file change -->

    <!-- ===================================================================================
         SGVS tokens. mirrors the "SGVS tokens" variable collection in Figma
         (color/accent -> SgvsAccentColor / SgvsAccentBrush, radius/control -> SgvsRadiusControl ...).
         the palette is still a placeholder, change the hex values here when it's final.
         =================================================================================== -->
    <Color x:Key="SgvsGroundColor">#110F0E</Color>
    <Color x:Key="SgvsSurfaceColor">#1C1A18</Color>
    <Color x:Key="SgvsSurfaceRaisedColor">#292623</Color>
    <Color x:Key="SgvsTextColor">#F0EEEC</Color>
    <Color x:Key="SgvsTextMutedColor">#B4B0AC</Color>
    <Color x:Key="SgvsAccentColor">#53C9C9</Color>
    <Color x:Key="SgvsOnAccentColor">#0E0F12</Color>
    <Color x:Key="SgvsGradientMidColor">#EDB25A</Color>
    <Color x:Key="SgvsGradientEndColor">#F3DAB2</Color>
    <Color x:Key="SgvsDangerTextColor">#F09A8E</Color>

    <SolidColorBrush x:Key="SgvsGroundBrush" Color="{StaticResource SgvsGroundColor}" />
    <SolidColorBrush x:Key="SgvsSurfaceBrush" Color="{StaticResource SgvsSurfaceColor}" />
    <SolidColorBrush x:Key="SgvsSurfaceRaisedBrush" Color="{StaticResource SgvsSurfaceRaisedColor}" />
    <SolidColorBrush x:Key="SgvsTextBrush" Color="{StaticResource SgvsTextColor}" />
    <SolidColorBrush x:Key="SgvsTextMutedBrush" Color="{StaticResource SgvsTextMutedColor}" />
    <SolidColorBrush x:Key="SgvsAccentBrush" Color="{StaticResource SgvsAccentColor}" />
    <SolidColorBrush x:Key="SgvsOnAccentBrush" Color="{StaticResource SgvsOnAccentColor}" />
    <SolidColorBrush x:Key="SgvsDangerTextBrush" Color="{StaticResource SgvsDangerTextColor}" />

    <CornerRadius x:Key="SgvsRadiusControl">8</CornerRadius>
    <x:Double x:Key="SgvsSizeControl">44</x:Double>

    <!-- avatar tones (Figma "Avatar / Tone=..."). each is a token color: the circle is it at 20%, the initial is it solid -->
    <SolidColorBrush x:Key="SgvsToneTealBrush" Color="{StaticResource SgvsAccentColor}" />
    <SolidColorBrush x:Key="SgvsToneAmberBrush" Color="{StaticResource SgvsGradientMidColor}" />
    <SolidColorBrush x:Key="SgvsToneSandBrush" Color="{StaticResource SgvsGradientEndColor}" />
    <SolidColorBrush x:Key="SgvsToneNeutralBrush" Color="{StaticResource SgvsTextMutedColor}" />

    <!-- live tile border: accent -> gradient-mid -> gradient-end, left to right -->
    <LinearGradientBrush x:Key="SgvsLiveStrokeBrush" StartPoint="0%,50%" EndPoint="100%,50%">
        <GradientStop Color="{StaticResource SgvsAccentColor}" Offset="0" />
        <GradientStop Color="{StaticResource SgvsGradientMidColor}" Offset="0.5" />
        <GradientStop Color="{StaticResource SgvsGradientEndColor}" Offset="1" />
    </LinearGradientBrush>

    <!-- glass surfaces: the control bar, gear, fullscreen button, menus and dialogs.
         ground at 56% with a hairline white edge. Avalonia has no per-element backdrop blur,
         so this is a flat approximation of the blur-behind effect in the mockup -->
    <SolidColorBrush x:Key="SgvsGlassBrush" Color="{StaticResource SgvsGroundColor}" Opacity="0.56" />
    <Color x:Key="SgvsGlassEdgeColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="SgvsGlassEdgeBrush" Color="{StaticResource SgvsGlassEdgeColor}" Opacity="0.12" />

    <!-- not in Figma (it has no hover/pressed states): a thin wash of the text color over the button -->
    <SolidColorBrush x:Key="SgvsHoverBrush" Color="{StaticResource SgvsTextColor}" Opacity="0.06" />
    <SolidColorBrush x:Key="SgvsPressedBrush" Color="{StaticResource SgvsTextColor}" Opacity="0.1" />

    <!-- shadows, same values as the Figma effects -->
    <BoxShadows x:Key="SgvsLiveTileShadow">0 8 28 0 #70000000</BoxShadows>
    <BoxShadows x:Key="SgvsMenuShadow">0 14 34 0 #80000000</BoxShadows>
    <Color x:Key="SgvsShadowColor">#000000</Color>
    <DropShadowEffect x:Key="SgvsTileNameShadow" OffsetX="0" OffsetY="1" BlurRadius="3"
                      Color="{StaticResource SgvsShadowColor}" Opacity="0.65" />

    <!-- Inter comes from the Avalonia.Fonts.Inter package. JetBrains Mono (OFL) is bundled in Assets/Fonts -->
    <FontFamily x:Key="SgvsUiFont">fonts:Inter#Inter</FontFamily>
    <FontFamily x:Key="SgvsCodeFont">avares://SGVS.Frontend/Assets/Fonts#JetBrains Mono, Consolas, monospace</FontFamily>

    <!-- line icons from the Figma file, path data copied as-is. they are strokes (2px, round ends), not fills,
         and the numbers are in the icon's own size (18 = an 18x18 box), so draw them with Path.lineicon
         inside a Panel of that size -->
    <!-- 18 -->
    <StreamGeometry x:Key="SgvsShareIcon">M15.75 9V11.25C15.75 11.4489 15.671 11.6397 15.5303 11.7803C15.3897 11.921 15.1989 12 15 12H3C2.80109 12 2.61032 11.921 2.46967 11.7803C2.32902 11.6397 2.25 11.4489 2.25 11.25V3.75C2.25 3.55109 2.32902 3.36032 2.46967 3.21967C2.61032 3.07902 2.80109 3 3 3H9.75M5.25 15H12.75M6.75 12V15M11.25 12V15M12.75 3H15.75V6M12 6.75L15.75 3</StreamGeometry>
    <!-- 18 -->
    <StreamGeometry x:Key="SgvsStopIcon">M3.75 5.25C3.75 4.85218 3.90804 4.47064 4.18934 4.18934C4.47064 3.90804 4.85218 3.75 5.25 3.75H12.75C13.1478 3.75 13.5294 3.90804 13.8107 4.18934C14.092 4.47064 14.25 4.85218 14.25 5.25V12.75C14.25 13.1478 14.092 13.5294 13.8107 13.8107C13.5294 14.092 13.1478 14.25 12.75 14.25H5.25C4.85218 14.25 4.47064 14.092 4.18934 13.8107C3.90804 13.5294 3.75 13.1478 3.75 12.75V5.25Z</StreamGeometry>
    <!-- 18 -->
    <StreamGeometry x:Key="SgvsLeaveIcon">M10.5 6V4.5C10.5 4.10218 10.342 3.72064 10.0607 3.43934C9.77936 3.15804 9.39782 3 9 3H3.75C3.35218 3 2.97064 3.15804 2.68934 3.43934C2.40804 3.72064 2.25 4.10218 2.25 4.5V13.5C2.25 13.8978 2.40804 14.2794 2.68934 14.5607C2.97064 14.842 3.35218 15 3.75 15H9C9.39782 15 9.77936 14.842 10.0607 14.5607C10.342 14.2794 10.5 13.8978 10.5 13.5V12M6.75 9H15.75L13.5 6.75M13.5 11.25L15.75 9</StreamGeometry>
    <!-- 18 -->
    <StreamGeometry x:Key="SgvsEyeIcon">M7.5 9C7.5 9.39782 7.65804 9.77936 7.93934 10.0607C8.22064 10.342 8.60218 10.5 9 10.5C9.39782 10.5 9.77936 10.342 10.0607 10.0607C10.342 9.77936 10.5 9.39782 10.5 9C10.5 8.60218 10.342 8.22064 10.0607 7.93934C9.77936 7.65804 9.39782 7.5 9 7.5C8.60218 7.5 8.22064 7.65804 7.93934 7.93934C7.65804 8.22064 7.5 8.60218 7.5 9ZM15.75 9C13.95 12 11.7 13.5 9 13.5C6.3 13.5 4.05 12 2.25 9C4.05 6 6.3 4.5 9 4.5C11.7 4.5 13.95 6 15.75 9Z</StreamGeometry>
    <!-- 18 -->
    <StreamGeometry x:Key="SgvsCheckIcon">M3.75 9L7.5 12.75L15 5.25</StreamGeometry>
    <!-- 14 -->
    <StreamGeometry x:Key="SgvsChevronUpIcon">M3.5 8.75L7 5.25L10.5 8.75</StreamGeometry>
    <!-- 20 -->
    <StreamGeometry x:Key="SgvsKeyIcon">M13.7958 3.2025L16.7975 6.20417C17.0202 6.4268 17.1968 6.69111 17.3173 6.98202C17.4378 7.27292 17.4998 7.58471 17.4998 7.89958C17.4998 8.21446 17.4378 8.52625 17.3173 8.81715C17.1968 9.10805 17.0202 9.37237 16.7975 9.595L14.595 11.7975C14.3724 12.0202 14.1081 12.1968 13.8172 12.3173C13.5262 12.4378 13.2145 12.4998 12.8996 12.4998C12.5847 12.4998 12.2729 12.4378 11.982 12.3173C11.6911 12.1968 11.4268 12.0202 11.2042 11.7975L10.9533 11.5467L5.48833 17.0117C5.21143 17.2885 4.8459 17.4591 4.45583 17.4933L4.31 17.5H3.33333C3.12922 17.5 2.93222 17.425 2.77969 17.2894C2.62716 17.1538 2.52971 16.9669 2.50583 16.7642L2.5 16.6667V15.69C2.5001 15.2987 2.63786 14.9199 2.88917 14.62L2.98833 14.5117L3.33333 14.1667H5V12.5H6.66667V10.8333L8.45333 9.04667L8.2025 8.79583C7.97983 8.5732 7.8032 8.30889 7.68269 8.01798C7.56219 7.72708 7.50016 7.41529 7.50016 7.10042C7.50016 6.78554 7.56219 6.47375 7.68269 6.18285C7.8032 5.89195 7.97983 5.62763 8.2025 5.405L10.405 3.2025C10.6276 2.97983 10.8919 2.8032 11.1828 2.68269C11.4738 2.56219 11.7855 2.50016 12.1004 2.50016C12.4153 2.50016 12.7271 2.56219 13.018 2.68269C13.3089 2.8032 13.5732 2.97983 13.7958 3.2025ZM12.5 7.5H12.5083</StreamGeometry>
    <!-- 22 -->
