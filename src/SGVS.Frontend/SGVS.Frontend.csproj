<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- bakes the icon into the .exe itself (Explorer, taskbar before the window even
         opens) - Windows-only, ignored elsewhere. the Window.Icon in MainWindow.axaml
         covers the runtime icon (taskbar/dock/window manager) on every platform -->
    <ApplicationIcon>Assets\sgvs-icon\sgvs.ico</ApplicationIcon>
    <!-- needs x:DataType in the axaml, but catches binding typos at build time -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <!-- the stand-in stream frame is a loose file, not an embedded resource -->
    <AvaloniaResource Include="Assets\**" Exclude="Assets\Placeholders\**" />
  </ItemGroup>

  <!-- stand-in stream frame until real call data exists.
       copied next to the exe (Link keeps the folder name FakeMeetingService looks for) -->
  <ItemGroup>
    <!-- frame shown for anyone streaming, on their gallery tile and on the Watch screen (the landscape from the Figma mockup) -->
    <Content Include="Assets\Placeholders\StreamPreview\**" Link="StreamPreview\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\PCM_Sounds\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- video file for playback - needs to be copied to output directory, not embedded -->
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- managed Opus decoder for incoming call audio -->
    <PackageReference Include="Concentus" Version="2.2.3" />
    <PackageReference Include="LibVLCSharp.Avalonia" Version="3.10.2" />
    <PackageReference Include="NAudio" Version="3.3.0" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.24" />
  </ItemGroup>

  <!-- shared memory the processing and networking modules also use (Windows only at runtime) -->
  <ItemGroup>
    <ProjectReference Include="..\shared_mem_lib\csharp\csharp.csproj" />
  </ItemGroup>

  <!-- builds the Go networking module into backend/ next to the app, which is where NetworkingProcess looks.
       needs Go on PATH; without it the app still builds but hosting/joining reports the module as missing.
       -p:SkipNetworkingBuild=true skips this -->
  <Target Name="BuildNetworking" AfterTargets="Build" Condition="'$(SkipNetworkingBuild)' != 'true'">
    <PropertyGroup>
      <NetworkingExeName Condition="$([MSBuild]::IsOSPlatform('Windows'))">sgvs-networking.exe</NetworkingExeName>
      <NetworkingExeName Condition="'$(NetworkingExeName)' == ''">sgvs-networking</NetworkingExeName>
      <!-- OutDir is relative to this project, but go runs from the networking folder -->
      <NetworkingOutDir>$([System.IO.Path]::GetFullPath('$(OutDir)', '$(MSBuildProjectDirectory)'))</NetworkingOutDir>
    </PropertyGroup>
    <Exec Command="go build -o &quot;$(NetworkingOutDir)backend/$(NetworkingExeName)&quot; ." WorkingDirectory="$(MSBuildThisFileDirectory)..\networking" ContinueOnError="true" IgnoreExitCode="true" StandardOutputImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="NetworkingBuildExit" />
    </Exec>
    <Warning Condition="'$(NetworkingBuildExit)' != '0'" Text="Could not build the networking module (is Go installed and on PATH?). The app will run but cannot host or join a meeting." />
  </Target>
</Project>
