<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- bakes the icon into the .exe itself (Explorer, taskbar before the window even
         opens) - Windows-only, ignored elsewhere. the Window.Icon in MainWindow.axaml
         covers the runtime icon (taskbar/dock/window manager) on every platform -->
    <ApplicationIcon>Assets\sgvs-icon\sgvs.ico</ApplicationIcon>
    <!-- needs x:DataType in the axaml, but catches binding typos at build time -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <!-- placeholders are loose files, not embedded resources -->
    <AvaloniaResource Include="Assets\**" Exclude="Assets\Placeholders\**" />
  </ItemGroup>

  <!-- stand-in stream media until real call data exists.
       copied next to the exe (Link keeps the folder names the view models look for) -->
  <ItemGroup>
    <Content Include="Assets\Placeholders\StreamImage\**" Link="StreamImage\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Placeholders\StreamVideo\**" Link="StreamVideo\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- video. the windows package ships the native libs, on linux it uses the installed VLC -->
    <PackageReference Include="LibVLCSharp.Avalonia" Version="3.10.2" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.24" />
  </ItemGroup>
</Project>
