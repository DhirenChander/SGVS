<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- colors + icons, looked up by key everywhere else.
         glass = white at low alpha over the blurred backdrop, so the alpha values are the whole look -->
    <SolidColorBrush x:Key="BgBrush" Color="#0B0D12" />

    <!-- panels (stream card, member list) -->
    <LinearGradientBrush x:Key="GlassBrush" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Color="#26FFFFFF" Offset="0" />
        <GradientStop Color="#0DFFFFFF" Offset="1" />
    </LinearGradientBrush>
    <!-- control bar, a bit denser so it reads over the video -->
    <LinearGradientBrush x:Key="GlassStrongBrush" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Color="#33FFFFFF" Offset="0" />
        <GradientStop Color="#1AFFFFFF" Offset="1" />
    </LinearGradientBrush>
    <!-- light catches the top-left edge, fades out toward the bottom-right -->
    <LinearGradientBrush x:Key="GlassBorderBrush" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Color="#59FFFFFF" Offset="0" />
        <GradientStop Color="#1AFFFFFF" Offset="0.5" />
        <GradientStop Color="#0DFFFFFF" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="GlassButtonBrush" Color="#1FFFFFFF" />        <!-- round buttons, pills -->
    <SolidColorBrush x:Key="GlassButtonHoverBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="SeparatorBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="TextBrush" Color="#F2FFFFFF" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#99FFFFFF" />

    <!-- apple system colors -->
    <SolidColorBrush x:Key="AccentBrush" Color="#0A84FF" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FF453A" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#FF6961" />
    <SolidColorBrush x:Key="DangerPressedBrush" Color="#D70015" />

    <!-- icons are Material Design paths (24x24), no icon font so it works on linux/mac too -->
    <StreamGeometry x:Key="MicIcon">M12,2A3,3 0 0,1 15,5V11A3,3 0 0,1 12,14A3,3 0 0,1 9,11V5A3,3 0 0,1 12,2M19,11C19,14.53 16.39,17.44 13,17.93V21H11V17.93C7.61,17.44 5,14.53 5,11H7A5,5 0 0,0 12,16A5,5 0 0,0 17,11H19Z</StreamGeometry>
    <StreamGeometry x:Key="VideoIcon">M17,10.5V7A1,1 0 0,0 16,6H4A1,1 0 0,0 3,7V17A1,1 0 0,0 4,18H16A1,1 0 0,0 17,17V13.5L21,17.5V6.5L17,10.5Z</StreamGeometry>
    <StreamGeometry x:Key="MonitorIcon">M21,16H3V4H21M21,2H3C1.89,2 1,2.89 1,4V16A2,2 0 0,0 3,18H10V20H8V22H16V20H14V18H21A2,2 0 0,0 23,16V4C23,2.89 22.1,2 21,2Z</StreamGeometry>
    <StreamGeometry x:Key="LeaveIcon">M16,17V14H9V10H16V7L21,12L16,17M14,2A2,2 0 0,1 16,4V6H14V4H5V20H14V18H16V20A2,2 0 0,1 14,22H5A2,2 0 0,1 3,20V4A2,2 0 0,1 5,2H14Z</StreamGeometry>
    <StreamGeometry x:Key="VolumeIcon">M14,3.23V5.29C16.89,6.15 19,8.83 19,12C19,15.17 16.89,17.84 14,18.7V20.77C18,19.86 21,16.28 21,12C21,7.72 18,4.14 14,3.23M16.5,12C16.5,10.23 15.5,8.71 14,7.97V16C15.5,15.29 16.5,13.76 16.5,12M3,9V15H7L12,20V4L7,9H3Z</StreamGeometry>
</ResourceDictionary>